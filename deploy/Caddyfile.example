# Site blocks to add to the server's Caddy config (/etc/caddy/Caddyfile),
# then reload with: sudo systemctl reload caddy
# Caddy gets and renews the HTTPS certificate for each domain by itself.

# Security headers for both sites. The "?" adds a header only when the app
# hasn't sent it already, so the backend's responses don't get it twice (a
# reverse proxy adds to the upstream's headers). One directive per header:
# several "?" headers in one block are added all or nothing.
# HSTS starts at one hour so a mistake is quick to undo. Raise it to 31536000
# (one year) together with SECURE_HSTS_SECONDS, once HTTPS has worked for a
# while (see "HTTPS" in backend/docs/deployment.md). No includeSubDomains: the
# server hosts other sites. The frontend's CSP comes from its nginx, don't
# repeat it here.
(security_headers) {
	header ?Strict-Transport-Security "max-age=3600"
	header ?X-Content-Type-Options nosniff
	header ?Referrer-Policy strict-origin-when-cross-origin
	header ?X-Frame-Options DENY
}

# Backend. The port is BACKEND_PORT from .env (default 8000).
api.example.com {
	import security_headers
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000
}

# Frontend. The port is FRONTEND_PORT from .env (default 8080).
# /api/ goes to the backend, so the site calls the API on its own domain.
example.com {
	import security_headers
	encode zstd gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}

# www redirects to the bare domain.
www.example.com {
	redir https://example.com{uri} permanent
}

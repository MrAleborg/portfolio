# Production settings. Copy to .env on the server (chmod 600). Never commit .env.
# Compose reads it for the variables in compose.yml, and passes it to the backend.

# Image tag to run. Each deploy writes it here (sha-<commit>) once the
# containers are healthy, so leave it out on a new server. Compose refuses to
# start without it. On a server that already runs the stack, add the line with
# the commit running now before the next deploy:
# TAG=sha-<commit>

# Port the backend listens on, on 127.0.0.1 only (Caddy proxies to it)
BACKEND_PORT=8000
# Port the frontend listens on, on 127.0.0.1 only (Caddy proxies to it)
FRONTEND_PORT=8080

# Django
# Generate a key with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
# example.com is for the API calls the site makes on its own domain (/api/);
# localhost is for the container health check
ALLOWED_HOSTS=api.example.com,example.com,localhost
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://example.com
DATABASE_URL=sqlite:////data/db.sqlite3

# Email (URL-encode @ and : in the user and password, e.g. %40).
# Emails people receive: sent with EMAIL_URL, from DEFAULT_FROM_EMAIL.
EMAIL_URL=smtp+tls://contact%40example.com:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=contact@example.com
# Server error reports: sent with SERVER_EMAIL_URL (default: EMAIL_URL), from
# SERVER_EMAIL, to ADMINS (comma-separated)
SERVER_EMAIL_URL=smtp+tls://logs%40example.com:password@smtp.example.com:587
SERVER_EMAIL=logs@example.com
ADMINS=you@example.com
# Where the contact page's messages go. Unset: the form answers 503.
CONTACT_EMAIL=you@example.com

# HSTS duration in seconds. Raise to 31536000 (1 year) once HTTPS works.
SECURE_HSTS_SECONDS=3600
# Whether HSTS also covers subdomains. Keep False on a server shared with other sites.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

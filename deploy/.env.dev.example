# Copy to deploy/.env.dev (not committed) for deploy/dev-deploy.sh.
# The Dev deploy workflow takes the same values from the variables of the
# "Portfolio dev" environment (see "Dev box" in backend/docs/deployment.md).
# ssh target of the dev box
DEV_HOST=dev-box.lan
DEV_USER=pi
# Extra hostnames Vite answers to (it always answers localhost and IPs),
# comma-separated; a leading dot allows subdomains.
DEV_ALLOWED_HOSTS=dev-box,.example.ts.net

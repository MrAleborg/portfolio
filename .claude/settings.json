{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    },
    "agent-protocols": {
      "source": { "source": "github", "repo": "arneesh/agent-protocols" }
    },
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    },
    "chrome-devtools-plugins": {
      "source": { "source": "github", "repo": "ChromeDevTools/chrome-devtools-mcp" }
    }
  },
  "enabledPlugins": {
    "agent-protocols@agent-protocols": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null || exit 0; cd \"$CLAUDE_PROJECT_DIR\" && graphify update . >/dev/null 2>&1 || true",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null || exit 0; graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null || exit 0; graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
